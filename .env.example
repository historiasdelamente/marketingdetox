# Claude CLI
CLAUDE_CLI_PATH=claude

# Ollama (optional, for haiku-level tasks)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Amazon SES (email sending)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-2
SES_FROM_EMAIL=apego@javiervieira.com
SES_FROM_NAME=Javier Vieira - Apego Detox

# API Protection
API_KEY=

# Python (for scripts)
PYTHON_PATH=python

# --- Paula (bot de WhatsApp) — ver docs/PAULA-HUMANA.md ---
OPENROUTER_API_KEY=
PAULA_MODEL=openai/gpt-4.1-mini
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Necesario para el MODO HUMANO (Paula responde por su cuenta tras esperar).
# Sin este token, el webhook cae solo al modo clásico síncrono.
MANYCHAT_API_TOKEN=

# Segundos que Paula espera a que ella termine de escribir (buffer de ráfaga).
PAULA_ESPERA_MS=10000
# Tope: aunque siga escribiendo, contesta a los 30 s.
PAULA_MAX_ESPERA_MS=30000
# PAULA_MODO=sync → fuerza el modo clásico (depuración)
# Para apagar la campaña de la clase: CLASE.activa = false en lib/whatsapp/contexto-clase.ts

# Transcripción de notas de voz (basta con UNA de las dos).
GROQ_API_KEY=
OPENAI_API_KEY=
